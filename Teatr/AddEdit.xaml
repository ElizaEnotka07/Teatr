<Page x:Class="Teatr.AddEdit"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Teatr"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddEdit">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Выбор спектакля -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Спектакль:" FontSize="25" />
        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="SpectacleComboBox"  Height="30"
              SelectedValue="{Binding СпектакльID}" FontSize="20" DisplayMemberPath="Название"/>

        <!-- Дата премьеры -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Дата премьеры:" FontSize="25" />
        <DatePicker Grid.Row="1" Grid.Column="1" FontSize="20" SelectedDate="{Binding Дата_премьеры}" Height="30"/>

        <!-- Период проведения -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Период проведения:" FontSize="25"  />
        <TextBox Grid.Row="2" Grid.Column="1" FontSize="20" Text="{Binding Период_проведения}"  Height="30"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Дни и время" FontSize="25" />
        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Дни_и_время}" Height="30" FontSize="20"
         x:Name="DaysTimeTextBox" 
         PreviewTextInput="DaysTimeTextBox_PreviewTextInput"
         GotFocus="DaysTimeTextBox_GotFocus"/>

        <!-- Цена билета -->
        <TextBlock Grid.Row="4" Grid.Column="0" Text="Цена билета:" FontSize="25" />
        <TextBox Grid.Row="4" Grid.Column="1" FontSize="20" Text="{Binding Цена_билета}"  Height="30"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SaveButton" Content="Сохранить" Margin="5" Width="100" Click="SaveButton_Click"/>
            <Button Content="Отмена" Margin="5" Width="100" Click="Button_Click"/>
        </StackPanel>
    </Grid>

</Page>
